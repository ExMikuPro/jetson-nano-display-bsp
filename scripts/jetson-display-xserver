#!/bin/sh
set -eu

XORG=/usr/lib/xorg/Xorg
HDMI_CHECK=/usr/local/sbin/jetson-hdmi-connected
SPI_CONFIG=/etc/X11/xorg-st7789.conf
SPI_CONFIG_DIR=/etc/X11/xorg-st7789.conf.d

if "$HDMI_CHECK"; then
	logger -t jetson-display-xserver "HDMI connected; using NVIDIA Xorg"
	exec "$XORG" "$@"
fi

logger -t jetson-display-xserver "HDMI disconnected; using ST7789V fbdev"

# The framebuffer module may be loaded asynchronously by udev.
i=0
while [ ! -e /dev/fb1 ] && [ "$i" -lt 100 ]; do
	sleep 0.1
	i=$((i + 1))
done

if [ ! -e /dev/fb1 ]; then
	echo "ST7789V framebuffer /dev/fb1 did not appear" >&2
	exit 1
fi

exec "$XORG" -config "$SPI_CONFIG" -configdir "$SPI_CONFIG_DIR" "$@"
